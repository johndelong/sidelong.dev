---
// The entrance. A flat dot grid with the sidelong plane on it; as you scroll, the grid tilts
// away into a floor and the doors stand up in a ring around the mat. Each further scroll stop
// turns the ring one step, so every door gets its turn at the front. Scroll back up to return.
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import { site } from '../site'

const places = site.places
---

<Base immersive>
  <div class="journey" id="journey" style={`--n: ${places.length}`}>
    <span class="rest" style="top: 0" aria-hidden="true"></span>
    {/* One stop per door, plus one more where the ring has come full circle */}
    {[...places, null].map((_, i) => <span class="rest" style={`top: calc(var(--tilt-span) + ${i} * var(--step))`} aria-hidden="true" />)}

    <div class="scene" id="scene">
      <div class="sky" aria-hidden="true"></div>

      <div class="world">
        <div class="ground">
          <div class="dots" aria-hidden="true"></div>

          <div class="mat" aria-hidden="true">
            <span class="mat-shadow"></span>
            {Array.from({ length: 8 }, (_, k) => <span class="mat-side" style={`--k: ${k}`} />)}
            <span class="mat-top"></span>
          </div>

          <nav class="places" id="places" aria-label="Places">
            {
              places.map((place, i) => {
                const Door = place.href ? 'a' : 'span'
                return (
                  <div class="place" style={`--c: linear-gradient(135deg, ${place.colors}); --i: ${i}`}>
                    <span class="pool" aria-hidden="true" />
                    <span class="shade" aria-hidden="true" />
                    <Door class:list={['door', { closed: !place.href, ink: place.ink }]} href={place.href || undefined} data-i={i}>
                      <span class="stand">
                        <span class="slab">
                          <span class="name">{place.label}</span>
                        </span>
                      </span>
                    </Door>
                  </div>
                )
              })
            }
          </nav>
        </div>
      </div>

      <div class="intro">
        <p class="wordmark" aria-hidden="true">sidelong</p>
        <div class="hello">
          <h1>Hi, I'm {site.author}. I make things on the side.</h1>
          <button class="button" id="enter" type="button">
            Come in
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- What the door at the front is, in words -->
      <div class="captions" aria-live="polite">
        {
          places.map((place, i) => (
            <p class="caption" style={`--i: ${i}`}>
              {place.blurb}
            </p>
          ))
        }
      </div>

      <!-- One dot per door: where you are in the ring, and a way to jump -->
      <div class="pager">
        {
          places.map((place, i) => (
            <button type="button" data-i={i} style={`--i: ${i}`} aria-label={`Bring ${place.label} to the front`}>
              <i />
            </button>
          ))
        }
      </div>

      <div class="flood" aria-hidden="true"></div>

      <div class="top"><Header id="home" /></div>
    </div>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client'

  const calm = matchMedia('(prefers-reduced-motion: reduce)')
  const clamp = (n: number, max = 1) => Math.min(max, Math.max(0, n))

  // The scroll stops: the entrance first, then one for each door at the front of the ring.
  const stops = (journey: HTMLElement) =>
    [...journey.querySelectorAll<HTMLElement>('.rest')].map((rest) => journey.offsetTop + rest.offsetTop)

  let turned = 0 // which door is at the front when there is no scrolling to say (reduced motion)
  let front = 0
  let count = 1

  // Read the scroll into two numbers: --p, how far the wall has tilted into a floor (0 to 1),
  // and --t, how far the ring has turned (0 for the first door, 1 for the second, and so on).
  let queued = false
  const update = () => {
    queued = false
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    if (!journey || !scene) return
    const [top, room, next] = stops(journey)
    count = scene.querySelectorAll('.place').length
    const p = calm.matches ? 1 : clamp((scrollY - top) / (room - top || 1))
    // The ring can turn one full circle: at the last stop the first door is at the front again.
    const t = calm.matches ? turned : clamp((scrollY - room) / (next - room || 1), count)
    front = Math.round(t) % count
    scene.style.setProperty('--p', p.toFixed(4))
    scene.style.setProperty('--e', (p * p * (3 - 2 * p)).toFixed(4)) // eased, for the tilt
    scene.style.setProperty('--t', t.toFixed(4))
    scene.classList.toggle('is-mid', p > 0.3)
    scene.classList.toggle('is-in', p > 0.92)
    if (p > 0.92) sessionStorage.setItem('sidelong-entered', '1')
  }
  const request = () => {
    if (!queued) requestAnimationFrame(update)
    queued = true
  }

  // Find where the mat's front edge lands on screen once you're in the room, so the line of
  // text can sit a fixed distance below it on any screen. The room is posed for a moment
  // (fully tilted, no lean) to take the reading, then put back before anything is painted.
  const measure = () => {
    const scene = document.getElementById('scene')
    const edge = scene?.querySelector('.mat-side')
    if (!scene || !edge) return
    scene.classList.add('is-measuring')
    scene.style.setProperty('--p', '1')
    scene.style.setProperty('--e', '1')
    scene.style.setProperty('--mx', '0.5')
    const foot = edge.getBoundingClientRect().bottom - scene.getBoundingClientRect().top
    scene.style.setProperty('--mat-foot', `${Math.round(foot)}px`)
    scene.style.removeProperty('--mx')
    scene.classList.remove('is-measuring')
    update()
  }

  addEventListener('scroll', request, { passive: true })
  addEventListener('resize', measure)

  // Going round again: the stop after the last door looks exactly like the first door's stop,
  // so once the scroll settles there, hop back to the first without anything moving on screen.
  let settle = 0
  addEventListener(
    'scroll',
    () => {
      clearTimeout(settle)
      settle = window.setTimeout(() => {
        const journey = document.getElementById('journey')
        if (!journey || calm.matches) return
        const all = stops(journey)
        if (scrollY >= all[all.length - 1] - 2) scrollTo({ top: all[1], behavior: 'instant' })
      }, 160)
    },
    { passive: true },
  )

  // Bring a door to the front: scroll to its stop, or just turn the ring if motion is reduced.
  const bring = (i: number) => {
    const journey = document.getElementById('journey')
    if (!journey) return
    if (calm.matches) {
      turned = i
      update()
    } else {
      // The first door can be reached two ways; take whichever stop is nearer.
      const all = stops(journey)
      const ways = i === 0 ? [all[1], all[all.length - 1]] : [all[i + 1]]
      const top = ways.reduce((a, b) => (Math.abs(b - scrollY) < Math.abs(a - scrollY) ? b : a))
      scrollTo({ top, behavior: 'smooth' })
    }
  }

  document.addEventListener('astro:page-load', () => {
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    if (!journey || !scene) return

    // Coming back during the same visit lands in the room; scrolling up still shows the entrance.
    if (sessionStorage.getItem('sidelong-entered') && scrollY < 4) {
      scrollTo({ top: stops(journey)[1], behavior: 'instant' })
    }
    measure()

    document.getElementById('enter')?.addEventListener('click', () => scrollTo({ top: stops(journey)[1], behavior: calm.matches ? 'instant' : 'smooth' }))

    document.getElementById('home')?.addEventListener('click', (e) => {
      e.preventDefault()
      scrollTo({ top: 0, behavior: calm.matches ? 'instant' : 'smooth' })
    })

    scene.querySelectorAll<HTMLElement>('.pager button').forEach((dot) => {
      dot.addEventListener('click', () => bring(Number(dot.dataset.i)))
    })

    scene.querySelectorAll<HTMLElement>('.door').forEach((door) => {
      // The room leans with the pointer, which moves the doors under it. While a door is hovered,
      // hold the lean still so the door can't slide out from under the pointer and flicker.
      door.addEventListener('pointerenter', () => {
        scene.style.setProperty('--mx', getComputedStyle(document.documentElement).getPropertyValue('--mx') || '0.5')
      })
      door.addEventListener('pointerleave', () => scene.style.removeProperty('--mx'))

      door.addEventListener('click', (e) => {
        const i = Number(door.dataset.i)
        // A door at the side or back comes round to the front first.
        if (i !== front) {
          e.preventDefault()
          bring(i)
          return
        }
        // Walking through the front door: move toward it, let its colour fill the view, then go.
        if (!(door instanceof HTMLAnchorElement)) return
        if (calm.matches || e.metaKey || e.ctrlKey || e.shiftKey) return
        e.preventDefault()
        scene.style.setProperty('--flood', getComputedStyle(door.parentElement!).getPropertyValue('--c'))
        scene.classList.add('is-leaving')
        setTimeout(() => navigate(door.href), 520)
      })
    })
  })
</script>

<style>
  /* Extra height to scroll through; the scene stays pinned while the scroll plays it.
     One long stretch tilts the wall into the floor, then a shorter one per door turns the ring. */
  .journey {
    --tilt-span: 140svh;
    --step: 30svh; /* short, so one wheel flick or swipe carries to the next door */
    position: relative;
    height: calc(100svh + var(--tilt-span) + var(--n) * var(--step));
  }

  /* The places the scroll comes to rest: the entrance, then each door at the front. The browser
     carries the visitor's own momentum into whichever one they're heading for. */
  .rest {
    position: absolute;
    left: 0;
    height: 1px;
    scroll-snap-align: start;
    scroll-snap-stop: always; /* one door per flick, never skipping past */
  }

  :global(html:has(.journey)) {
    scroll-snap-type: y mandatory;
  }

  .scene {
    --p: 0;
    --e: 0;
    --t: 0;
    --tilt: calc(var(--e) * 70deg);
    --horizon: 66%;
    /* Sizes, in px on the floor: the mat, the doors, and the ring the doors stand on */
    --mat-w: min(760px, 53vw);
    --mat-h: calc(var(--mat-w) * 0.58);
    --mat-r: 44px;
    --mat-grow: 0.36; /* how much the mat widens into a stage as you enter */
    --mat-up: 27px; /* the height of its top face above the floor */
    --hover: 22px; /* how far the doors float above it */
    --door-w: 190px;
    --door-h: 260px;
    /* The ring sits inside the grown mat, so the doors travel over it, never through it */
    --rx: calc(var(--mat-w) * 0.52);
    --ry: calc(var(--mat-h) * 0.46);
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ground);
    perspective: 1100px;
    perspective-origin: 50% 40%;
  }

  /* A little warm light at the horizon once you're inside */
  .sky {
    position: absolute;
    inset: 0;
    opacity: calc(var(--e) * 0.55);
    background: radial-gradient(
      ellipse 60% 42% at 50% 26%,
      rgba(255, 130, 102, 0.3),
      rgba(242, 89, 156, 0.14) 45%,
      transparent 72%
    );
  }

  /* The camera: settles lower and closer as you enter, follows the pointer a little,
     and moves forward when you walk through the front door */
  .world {
    position: absolute;
    inset: 0;
    pointer-events: none; /* only the doors take clicks, wherever they sit in depth */
    transform-style: preserve-3d;
    transform-origin: 50% var(--horizon);
    transform: translate3d(0, calc(var(--e) * 4vh), calc(var(--e) * 110px))
      rotateY(calc(var(--e) * (var(--mx, 0.5) - 0.5) * -5deg));
    transition: transform 0.25s ease-out;
  }

  .is-measuring .world {
    transition: none;
  }

  .is-leaving .world {
    transform: translate3d(0, 4vh, 460px);
    transition: transform 0.7s var(--ease);
  }

  /* The ground: flat like a wall at first, then tilted away into a floor */
  .ground {
    position: absolute;
    left: 50%;
    top: var(--horizon);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt));
  }

  .dots {
    position: absolute;
    left: -2200px;
    top: -2700px;
    width: 4400px;
    height: 3400px;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 32%, transparent) 1.2px, transparent 1.9px);
    background-size: var(--dots) var(--dots);
    -webkit-mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
    mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
  }

  /* The sidelong plane: the mark on the entrance, then a mat on the floor. It is a slab, not a
     sheet: a stack of darker layers gives it an edge, and a tight shadow sits it on the floor. */
  .mat {
    position: absolute;
    left: calc(var(--mat-w) / -2);
    top: calc(var(--mat-h) * -1);
    width: var(--mat-w);
    height: var(--mat-h);
    transform-style: preserve-3d;
    transform: skewX(calc(var(--angle) * -1)) scale(calc(1 + var(--e) * var(--mat-grow)));
  }

  .mat span {
    position: absolute;
    inset: 0;
    border-radius: var(--mat-r);
  }

  .mat-shadow {
    inset: 10px -6px -18px 6px;
    background: rgba(24, 10, 36, 0.4);
    filter: blur(18px);
    box-shadow: -30px 44px 90px var(--shadow);
  }

  .mat-side {
    background: var(--wallpaper);
    filter: brightness(0.6) saturate(1.15);
    transform: translateZ(calc(var(--k) * 3px + 1px));
  }

  /* The top face: the gradient, a rim of light, and a soft sheen that follows the pointer */
  .mat-top {
    background:
      linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.3) 50%, transparent 70%)
        calc(var(--mx, 0.5) * 100%) 0 / 260% 100% no-repeat,
      var(--wallpaper);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.4),
      inset 0 -14px 30px rgba(60, 20, 80, 0.14);
    transform: translateZ(26px);
    transition: background-position 0.6s var(--ease);
  }

  .places {
    transform-style: preserve-3d; /* keep the doors in the floor's 3D space */
  }

  /* Each door stands on a ring on the mat. --off is how many places it is from the front, counted
     the short way round, and --a is that as an angle: 0 is the front.
     As --t grows with the scroll, every door moves one place round.
     --show runs 0 to 1 as the door first rises; --front is 1 at the front and 0 at the back;
     --near is 1 only while this door is the one at the front. */
  .place {
    --off: calc(mod(var(--i) - var(--t) + var(--n) * 1.5, var(--n)) - var(--n) / 2);
    --a: calc(var(--off) * 360deg / var(--n));
    --front: calc((cos(var(--a)) + 1) / 2);
    --near: clamp(0, calc(1 - max(var(--off), var(--off) * -1) * 2), 1);
    --show: clamp(0, calc((var(--p) - 0.5 - var(--i) * 0.05) * 5), 1);
    position: absolute;
    left: calc(sin(var(--a)) * var(--rx));
    top: calc((var(--mat-h) / 2 - cos(var(--a)) * var(--ry)) * -1);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translateZ(var(--mat-up)); /* up onto the mat's top face */
  }

  /* The front door's colour, as light on the mat beneath it */
  .pool {
    position: absolute;
    left: -200px;
    top: -110px;
    width: 400px;
    height: 220px;
    border-radius: 50%;
    background: var(--c);
    filter: blur(44px);
    opacity: calc(var(--show) * var(--near) * 0.55);
    pointer-events: none;
  }

  /* The shadow each floating door casts on the mat */
  .shade {
    position: absolute;
    left: calc(var(--door-w) * -0.55);
    top: -16px;
    width: calc(var(--door-w) * 1.1);
    height: 40px;
    border-radius: 50%;
    background: rgba(24, 10, 36, 0.55);
    filter: blur(16px);
    opacity: calc(var(--show) * (0.35 + 0.4 * var(--front)));
    pointer-events: none;
  }

  .door {
    position: absolute;
    left: 0;
    bottom: 0;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transform: translateZ(calc(var(--e) * var(--hover))) translateX(-50%) rotateX(calc(var(--tilt) * -1));
    transform-origin: 50% 100%;
  }

  .is-in .door {
    pointer-events: auto;
  }

  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: var(--show);
    transform: translateY(calc((1 - var(--show)) * 70px));
  }

  /* Each door wears its own colour, with its name on it in the wordmark's type */
  .slab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--door-w);
    height: var(--door-h);
    overflow: hidden;
    border-radius: 28px;
    background: var(--c);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
    color: #fff;
    transform: skewX(calc(var(--angle) * -1));
    transition: transform 0.5s var(--ease);
  }

  .ink .slab {
    color: #1f1a24;
  }

  /* Doors further round the ring fade toward the room's colour. A wash, not transparency,
     so the mat never shows through them. */
  .slab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--ground);
    opacity: calc((1 - var(--front)) * 0.5);
  }

  /* A little light across the door on hover */
  .slab::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .door:hover .slab,
  .door:focus-visible .slab {
    transform: skewX(calc(var(--angle) * -1)) translateY(-12px);
  }

  .door:hover .slab::after,
  .door:focus-visible .slab::after {
    opacity: 0.12;
  }

  .name {
    position: relative;
    z-index: 1;
    padding: 0 16px;
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    font-size: 27px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-align: center;
    transform: skewX(var(--angle));
  }

  /* The entrance: wordmark on the plane, a greeting and one button. Fades as you scroll. */
  .intro {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--p) * 3.4);
    transform: translateY(calc(var(--p) * -90px));
  }

  .is-mid .intro {
    visibility: hidden;
  }

  .wordmark {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--horizon) - var(--mat-h));
    display: grid;
    place-items: center;
    height: var(--mat-h);
    margin: 0;
    color: #1f1a24;
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(64px, 11vw, 148px);
    letter-spacing: -0.04em;
  }

  .hello {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--horizon) + 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 0 24px;
    text-align: center;
    pointer-events: auto;
  }

  .hello h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .hello .button {
    gap: 8px;
    border: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .hello .button:hover {
    transform: translateY(3px);
  }

  /* The line about the door at the front. All the lines sit in one spot, a fixed distance below
     the mat; only the nearest shows. */
  .captions {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--mat-foot, 84%) + 24px); /* just below the mat's front edge */
    height: 28px;
    pointer-events: none;
    opacity: clamp(0, calc((var(--p) - 0.8) * 5), 1);
  }

  .caption {
    --off: calc(mod(var(--i) - var(--t) + var(--n) * 1.5, var(--n)) - var(--n) / 2);
    --near: clamp(0, calc(1 - max(var(--off), var(--off) * -1) * 2), 1);
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0 24px;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink-2);
    text-align: center;
    opacity: var(--near);
    transform: translateX(calc(var(--off) * 60px));
  }

  .pager {
    position: absolute;
    right: 22px;
    top: 50%;
    display: flex;
    flex-direction: column;
    opacity: clamp(0, calc((var(--p) - 0.8) * 5), 1);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .is-in .pager {
    pointer-events: auto;
  }

  .pager button {
    --off: calc(mod(var(--i) - var(--t) + var(--n) * 1.5, var(--n)) - var(--n) / 2);
    --near: clamp(0, calc(1 - max(var(--off), var(--off) * -1)), 1);
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .pager i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    opacity: calc(0.28 + 0.72 * var(--near));
    transform: scale(calc(1 + 0.7 * var(--near)));
  }

  /* Inside: the shared header, fading in as you arrive. The brand takes you back up. */
  .top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 1;
    opacity: clamp(0, calc((var(--p) - 0.7) * 4), 1);
    pointer-events: none;
  }

  .is-in .top {
    pointer-events: auto;
  }

  .flood {
    position: absolute;
    inset: 0;
    background: var(--flood, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .is-leaving .flood {
    opacity: 1;
  }

  /* Phones: the same room, sized down. One door fits at the front, with its neighbours
     peeking in from the edges. */
  @media (max-width: 820px) {
    .scene {
      --mat-w: min(86vw, 340px);
      --mat-h: 190px;
      --mat-r: 28px;
      --mat-grow: 1.05; /* the stage runs off both sides of a phone screen */
      --door-w: 150px;
      --door-h: 205px;
      --rx: 250px;
      --ry: 150px;
      min-height: 560px;
    }

    .name {
      font-size: 22px;
    }

    .hello h1 {
      font-size: 19px;
    }

    .pager {
      right: 4px;
    }
  }

  /* Reduced motion: no scroll-through; you start in the room, and doors turn the ring when tapped */
  @media (prefers-reduced-motion: reduce) {
    .journey {
      height: auto;
    }

    :global(html:has(.journey)) {
      scroll-snap-type: none;
    }

    .rest {
