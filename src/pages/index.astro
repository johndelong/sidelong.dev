---
// The entrance. A flat dot grid with the sidelong plane on it; as you scroll down, the grid tilts
// away into a floor and the doors stand up in a ring around the mat. Inside, scrolling sideways
// turns the ring one door at a time, all the way round either way. Scroll back up to return.
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import { site } from '../site'

const places = site.places
---

<Base immersive>
  <div class="scroller" id="scroller">
  <div class="journey" id="journey" style={`--n: ${places.length}`}>
    <span class="rest" style="top: 0" aria-hidden="true"></span>
    <span class="rest" style="top: var(--tilt-span)" aria-hidden="true"></span>

    <div class="scene" id="scene">
      {/* The sideways scroll that turns the ring: one stop per door, plus one either side of them
          that looks just like the door at the other end, so the ring can keep going round */}
      <div class="track" aria-hidden="true">
        {[null, ...places, null].map(() => <span />)}
      </div>

      <div class="view">
      <div class="sky" aria-hidden="true"></div>

      <div class="world">
        <div class="ground">
          <div class="dots" aria-hidden="true"></div>

          <div class="mat" aria-hidden="true">
            <span class="mat-shadow"></span>
            {Array.from({ length: 8 }, (_, k) => <span class="mat-side" style={`--k: ${k}`} />)}
            <span class="mat-top"></span>
          </div>

          <nav class="places" id="places" aria-label="Places">
            {
              places.map((place, i) => {
                const Door = place.href ? 'a' : 'span'
                return (
                  <div class="place" style={`--c: linear-gradient(135deg, ${place.colors}); --i: ${i}`}>
                    <span class="pool" aria-hidden="true" />
                    <span class="shade" aria-hidden="true" />
                    <Door class:list={['door', { closed: !place.href, ink: place.ink }]} href={place.href || undefined} data-i={i}>
                      <span class="stand">
                        <span class="slab">
                          <span class="name">{place.label}</span>
                        </span>
                      </span>
                    </Door>
                  </div>
                )
              })
            }
          </nav>
        </div>
      </div>

      <div class="intro">
        <p class="wordmark" aria-hidden="true">sidelong</p>
        <div class="hello">
          <h1>Hi, I'm {site.author}. I make things on the side.</h1>
          <button class="button" id="enter" type="button">
            Come in
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- What the door at the front is, in words -->
      <div class="captions" aria-live="polite">
        {
          places.map((place, i) => (
            <p class="caption" style={`--i: ${i}`}>
              {place.blurb}
            </p>
          ))
        }
      </div>

      <!-- One dot per door: where you are in the ring, and a way to jump -->
      <div class="pager">
        {
          places.map((place, i) => (
            <button type="button" data-i={i} style={`--i: ${i}`} aria-label={`Bring ${place.label} to the front`}>
              <i />
            </button>
          ))
        }
      </div>

      <div class="top"><Header id="home" /></div>
      </div>
    </div>
  </div>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client'
  import { covering, grow, reveal, shrinkInto } from '../scripts/veil'

  const calm = matchMedia('(prefers-reduced-motion: reduce)')
  const clamp = (n: number, max = 1) => Math.min(max, Math.max(0, n))
  const wrap = (i: number, n: number) => ((i % n) + n) % n

  // Down and up: in and out of the room. On touch screens that scroll happens inside its own
  // full-screen box, not the page (see .scroller in the styles), so Safari keeps its toolbar still
  // and the viewport doesn't resize mid-swipe. Everything reads and moves it through here.
  const touch = matchMedia('(hover: none) and (pointer: coarse)')
  const box = () => (touch.matches ? document.getElementById('scroller') : null)
  const scrolled = () => box()?.scrollTop ?? scrollY
  const go = (top: number, behavior: ScrollBehavior) => (box() ?? window).scrollTo({ top, behavior })

  // The two places the vertical scroll rests: the entrance, and inside the room.
  const stops = (journey: HTMLElement) =>
    [...journey.querySelectorAll<HTMLElement>('.rest')].map((rest) => journey.offsetTop + rest.offsetTop)

  // Sideways: the scene scrolls across a track of n + 2 stops, a screen wide each. Stop 0 stands
  // in for the last door and stop n + 1 for the first, so the ring can turn past either end.
  const turnedTo = (scene: HTMLElement) => scene.scrollLeft / (scene.clientWidth || 1) - 1
  const turn = (scene: HTMLElement, stop: number, behavior: ScrollBehavior) =>
    scene.scrollTo({ left: stop * scene.clientWidth, behavior })

  let front = 0
  let count = 1
  let inside: boolean | null = null // fully in the room (null until the first reading)
  let kept = -1 // the door last noted for the visit, so coming back lands on it

  // Where you land depends on how you arrived. Back from a door's page: in the room, on that door.
  // A reload: wherever you were, splash or room. Anything else (a new tab, a typed address, a link
  // from elsewhere): the splash. How this document was loaded, and where you last were, are read
  // here, before anything on the page can change them.
  const loaded = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined
  const loadedHome = !loaded || (new URL(loaded.name).pathname.replace(/\/$/, '') || '/') === '/'
  const reloaded = loaded?.type === 'reload' || loaded?.type === 'back_forward'
  const wasAt = sessionStorage.getItem('sidelong-at')
  let firstVisit = true
  history.scrollRestoration = 'manual' // the page is put where it belongs here, not by the browser

  // Read both scrolls into two numbers: --p, how far the wall has tilted into a floor (0 to 1),
  // and --t, how far the ring has turned (0 for the first door, 1 for the second, and so on).
  //
  // The tilt eases toward where the scroll says it should be rather than jumping with it. A slow
  // drag still tracks the finger, but a flick, a snap, or the Come in button (all of which cover
  // the distance in about half a second) can't whip the room round faster than the eye can follow.
  // It moves like a critically damped spring: it starts from rest, gathers speed, and settles
  // without overshooting.
  const stiffness = 5.5 // a full tilt takes about 1.2s to settle
  let shown = 0 // the tilt on screen
  let speed = 0 // and how fast it's moving
  let jump = true // land on the scroll's tilt directly: on page load, and with reduced motion
  let last = 0
  let queued = false
  const update = (now = performance.now()) => {
    queued = false
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    if (!journey || !scene) return
    const [top, room] = stops(journey)
    const target = calm.matches ? 1 : clamp((scrolled() - top) / (room - top || 1))
    const dt = Math.min(1 / 30, (now - last) / 1000)
    last = now
    if (jump) {
      shown = target
      speed = 0
    } else {
      // One exact step of the spring toward the target
      const off = shown - target
      const pull = (speed + stiffness * off) * dt
      const decay = Math.exp(-stiffness * dt)
      shown = target + (off + pull) * decay
      speed = (speed - stiffness * pull) * decay
    }
    jump = false
    if (Math.abs(target - shown) < 0.001 && Math.abs(speed) < 0.01) {
      shown = target
      speed = 0
    } else {
      request() // keep moving on the next frame
    }
    const p = shown
    const t = turnedTo(scene)
    front = wrap(Math.round(t), count)
    scene.style.setProperty('--p', p.toFixed(4))
    scene.style.setProperty('--e', (p * p * (3 - 2 * p)).toFixed(4)) // eased, for the tilt
    scene.style.setProperty('--t', t.toFixed(4))
    scene.classList.toggle('is-mid', p > 0.3)
    if (p > 0.92 !== inside) {
      inside = p > 0.92
      scene.classList.toggle('is-in', inside)
      // Until you're in, the room can't be reached with the keyboard either
      for (const part of scene.querySelectorAll<HTMLElement>('.places, .pager, .top')) part.inert = !inside
      if (inside) sessionStorage.setItem('sidelong-entered', '1')
      sessionStorage.setItem('sidelong-at', inside ? 'room' : 'splash')
    }
    if (inside && front !== kept) {
      kept = front
      sessionStorage.setItem('sidelong-door', String(front))
    }
  }
  const request = () => {
    if (!queued) requestAnimationFrame(update)
    queued = true
  }

  // Find where the mat's front edge lands on screen once you're in the room, so the line of
  // text can sit a fixed distance below it on any screen. The room is posed for a moment
  // (fully tilted, no lean) to take the reading, then put back before anything is painted.
  // The sideways scroll is put back on the door that was at the front, at the new width.
  const measure = () => {
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    const edge = scene?.querySelector('.mat-side')
    if (!journey || !scene || !edge) return
    turn(scene, front + 1, 'instant')
    scene.classList.add('is-measuring')
    scene.style.setProperty('--p', '1')
    scene.style.setProperty('--e', '1')
    scene.style.setProperty('--mx', '0.5')
    const foot = edge.getBoundingClientRect().bottom - scene.getBoundingClientRect().top
    scene.style.setProperty('--mat-foot', `${Math.round(foot)}px`)
    scene.style.removeProperty('--mx')
    scene.classList.remove('is-measuring')
    update()
  }

  // Scroll events from an element don't reach the window, so the box and the scene get their own
  // listeners (added on page load, as they're new on every visit).
  addEventListener('scroll', request, { passive: true })

  addEventListener('resize', measure)

  // Going round: the stops at either end look exactly like the door at the other end, so once the
  // ring settles on one, hop to its twin without anything moving on screen.
  let settle = 0
  const settled = () => {
    clearTimeout(settle)
    settle = window.setTimeout(() => {
      const scene = document.getElementById('scene')
      if (!scene) return
      const t = Math.round(turnedTo(scene))
      if (t < 0) turn(scene, count, 'instant')
      else if (t >= count) turn(scene, 1, 'instant')
    }, 160)
  }

  // Bring a door to the front: turn to its stop, or its twin if that's nearer. With reduced
  // motion the ring jumps there instead of turning.
  const bring = (i: number) => {
    const scene = document.getElementById('scene')
    if (!scene) return
    i = wrap(i, count)
    const now = turnedTo(scene)
    const ways = [i - count, i, i + count].filter((t) => t >= -1 && t <= count)
    const t = ways.reduce((a, b) => (Math.abs(b - now) < Math.abs(a - now) ? b : a))
    turn(scene, t + 1, calm.matches ? 'instant' : 'smooth')
  }

  // The arrow keys turn the ring too, once you're inside.
  addEventListener('keydown', (e) => {
    const scene = document.getElementById('scene')
    if (!scene?.classList.contains('is-in') || e.metaKey || e.ctrlKey || e.altKey) return
    if (e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable]')) return
    const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
    if (!step) return
    e.preventDefault()
    bring(front + step)
  })

  document.addEventListener('astro:page-load', () => {
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    jump = true
    inside = null
    kept = -1
    if (!journey || !scene) return
    count = scene.querySelectorAll('.place').length
    const fromLoad = firstVisit && loadedHome // this page load, not a move from another page
    firstVisit = false
    const room = fromLoad ? reloaded && wasAt === 'room' : !!sessionStorage.getItem('sidelong-entered')
    // In the room, the door you last had at the front is there again
    front = room ? wrap(Number(sessionStorage.getItem('sidelong-door')) || 0, count) : 0
    document.getElementById('scroller')?.addEventListener('scroll', request, { passive: true })
    scene.addEventListener('scroll', request, { passive: true })
    scene.addEventListener('scroll', settled, { passive: true })

    // Scrolling up from the room still shows the entrance
    if (fromLoad) go(room ? stops(journey)[1] : 0, 'instant')
    else if (room && scrolled() < 4) go(stops(journey)[1], 'instant')
    measure()

    // Arriving back from a door's page under its colour panel: shrink it back into that door
    if (covering()) {
      const slab = inside ? scene.querySelector<HTMLElement>(`.door[data-i="${front}"] .slab`) : null
      if (slab) shrinkInto(slab)
      else reveal()
    }

    document.getElementById('enter')?.addEventListener('click', () => go(stops(journey)[1], calm.matches ? 'instant' : 'smooth'))

    document.getElementById('home')?.addEventListener('click', (e) => {
      e.preventDefault()
      go(0, calm.matches ? 'instant' : 'smooth')
    })

    scene.querySelectorAll<HTMLElement>('.pager button').forEach((dot) => {
      dot.addEventListener('click', () => bring(Number(dot.dataset.i)))
    })

    scene.querySelectorAll<HTMLElement>('.door').forEach((door) => {
      // The room leans with the pointer, which moves the doors under it. While a door is hovered,
      // hold the lean still so the door can't slide out from under the pointer and flicker.
      door.addEventListener('pointerenter', () => {
        scene.style.setProperty('--mx', getComputedStyle(document.documentElement).getPropertyValue('--mx') || '0.5')
      })
      door.addEventListener('pointerleave', () => scene.style.removeProperty('--mx'))

      door.addEventListener('click', (e) => {
        const i = Number(door.dataset.i)
        // A door at the side or back comes round to the front first.
        if (i !== front) {
          e.preventDefault()
          bring(i)
          return
        }
        // Walking through the front door: move toward it while it grows to fill the screen, then go.
        if (!(door instanceof HTMLAnchorElement)) return
        if (calm.matches || e.metaKey || e.ctrlKey || e.shiftKey) return
        e.preventDefault()
        scene.classList.add('is-leaving')
        grow(door.querySelector<HTMLElement>('.slab')!).then(() => navigate(door.href))
      })
    })
  })
</script>

<style>
  /* Extra height to scroll through; the scene stays pinned while the scroll tilts the wall into
     the floor. Turning the ring is sideways, on the scene itself. */
  .journey {
    --tilt-span: 140svh;
    position: relative;
    height: calc(100svh + var(--tilt-span));
  }

  /* The entrance and inside the room, the two ends of the scroll. The scroll only settles onto
     one when it stops close by ("proximity"): a slow drag can rest anywhere in between, while a
     flick's momentum, or Come in, carries all the way to the end. */
  .rest {
    position: absolute;
    left: 0;
    height: 1px;
    scroll-snap-align: start;
  }

  :global(html:has(.journey)) {
    scroll-snap-type: y proximity;
  }

  /* On touch screens, scroll the journey inside a full-screen box instead of the page. Safari only
     collapses its toolbar when the page itself scrolls, and that collapse resizes the viewport in
     the middle of the swipe into the room, which stutters. In a box the viewport never changes. */
  @media (hover: none) and (pointer: coarse) {
    :global(html:has(.journey)),
    :global(body:has(.journey)) {
      height: 100%;
      overflow: hidden;
      scroll-snap-type: none;
    }

    .scroller {
      position: fixed;
      inset: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: none; /* the room doesn't bounce away from the edges */
      scroll-snap-type: y proximity;
    }
  }

  .scene {
    --p: 0;
    --e: 0;
    --t: 0;
    --tilt: calc(var(--e) * 70deg);
    --horizon: 66%;
    /* Sizes, in px on the floor: the mat, the doors, and the ring the doors stand on */
    --mat-w: min(760px, 53vw);
    --mat-h: calc(var(--mat-w) * 0.58);
    --mat-r: 44px;
    --mat-grow: 0.36; /* how much the mat widens into a stage as you enter */
    --mat-up: 27px; /* the height of its top face above the floor */
    --hover: 22px; /* how far the doors float above it */
    --door-w: 190px;
    --door-h: 260px;
    /* The ring sits inside the grown mat, so the doors travel over it, never through it */
    --rx: calc(var(--mat-w) * 0.52);
    --ry: calc(var(--mat-h) * 0.46);
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 640px;
    background: var(--ground);
    /* The scene is also the sideways scroll that turns the ring, so a swipe that starts on a door
       turns it too. Locked until you're inside; no bounce, and no swiping back a page on a trackpad. */
    overflow: hidden;
    overscroll-behavior-x: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .scene::-webkit-scrollbar {
    display: none;
  }

  .scene.is-in {
    overflow-x: auto;
  }

  /* The stops the sideways scroll snaps to: one door per flick, never skipping past */
  .track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: calc((var(--n) + 2) * 100%);
    height: 1px;
  }

  .track span {
    flex: 1;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Everything you see, pinned in place while the scene scrolls sideways beneath it */
  .view {
    position: sticky;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    perspective: 1100px;
    perspective-origin: 50% 40%;
  }

  /* A little warm light at the horizon once you're inside */
  .sky {
    position: absolute;
    inset: 0;
    opacity: calc(var(--e) * 0.55);
    background: radial-gradient(
      ellipse 60% 42% at 50% 26%,
      rgba(255, 130, 102, 0.3),
      rgba(242, 89, 156, 0.14) 45%,
      transparent 72%
    );
  }

  /* The camera: settles lower and closer as you enter, follows the pointer a little,
     and moves forward when you walk through the front door */
  .world {
    position: absolute;
    inset: 0;
    pointer-events: none; /* only the doors take clicks, wherever they sit in depth */
    transform-style: preserve-3d;
    transform-origin: 50% var(--horizon);
    /* The move in and the lean are separate properties so only the lean is eased here: the move
       in already eases in the script, and easing it twice left the camera trailing the floor. */
    translate: 0 calc(var(--e) * 4vh) calc(var(--e) * 110px);
    rotate: y calc(var(--e) * (var(--mx, 0.5) - 0.5) * -5deg);
    transition: rotate 0.25s ease-out;
  }

  .is-measuring .world {
    transition: none;
  }

  .is-leaving .world {
    translate: 0 4vh 460px;
    rotate: y 0deg;
    transition:
      translate 0.7s var(--ease),
      rotate 0.7s var(--ease);
  }

  /* The ground: flat like a wall at first, then tilted away into a floor */
  .ground {
    position: absolute;
    left: 50%;
    top: var(--horizon);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt));
  }

  .dots {
    position: absolute;
    left: -2200px;
    top: -2700px;
    width: 4400px;
    height: 3400px;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 32%, transparent) 1.2px, transparent 1.9px);
    background-size: var(--dots) var(--dots);
    -webkit-mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
    mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
  }

  /* The sidelong plane: the mark on the entrance, then a mat on the floor. It is a slab, not a
     sheet: a stack of darker layers gives it an edge, and a tight shadow sits it on the floor. */
  .mat {
    position: absolute;
    left: calc(var(--mat-w) / -2);
    top: calc(var(--mat-h) * -1);
    width: var(--mat-w);
    height: var(--mat-h);
    transform-style: preserve-3d;
    transform: skewX(calc(var(--angle) * -1)) scale(calc(1 + var(--e) * var(--mat-grow)));
  }

  .mat span {
    position: absolute;
    inset: 0;
    border-radius: var(--mat-r);
  }

  .mat-shadow {
    inset: 10px -6px -18px 6px;
    background: rgba(24, 10, 36, 0.4);
    filter: blur(18px);
    box-shadow: -30px 44px 90px var(--shadow);
  }

  .mat-side {
    background: var(--wallpaper);
    filter: brightness(0.6) saturate(1.15);
    transform: translateZ(calc(var(--k) * 3px + 1px));
  }

  /* The top face: the gradient, a rim of light, and a soft sheen that follows the pointer */
  .mat-top {
    background:
      linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.3) 50%, transparent 70%)
        calc(var(--mx, 0.5) * 100%) 0 / 260% 100% no-repeat,
      var(--wallpaper);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.4),
      inset 0 -14px 30px rgba(60, 20, 80, 0.14);
    transform: translateZ(26px);
    transition: background-position 0.6s var(--ease);
  }

  .places {
    transform-style: preserve-3d; /* keep the doors in the floor's 3D space */
  }

  /* Each door stands on a ring on the mat. --off is how many places it is from the front, counted
     the short way round, and --a is that as an angle: 0 is the front.
     As --t grows with the scroll, every door moves one place round.
     --show runs 0 to 1 as the door first rises; --front is 1 at the front and 0 at the back;
     --near is 1 only while this door is the one at the front. */
  .place {
    --off: calc(mod(var(--i) - var(--t) + var(--n) * 1.5, var(--n)) - var(--n) / 2);
    --a: calc(var(--off) * 360deg / var(--n));
    --front: calc((cos(var(--a)) + 1) / 2);
    --near: clamp(0, calc(1 - max(var(--off), var(--off) * -1) * 2), 1);
    --show: clamp(0, calc((var(--p) - 0.5 - var(--i) * 0.05) * 5), 1);
    position: absolute;
    left: calc(sin(var(--a)) * var(--rx));
    top: calc((var(--mat-h) / 2 - cos(var(--a)) * var(--ry)) * -1);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translateZ(var(--mat-up)); /* up onto the mat's top face */
  }

  /* The front door's colour, as light on the mat beneath it */
  .pool {
    position: absolute;
    left: -200px;
    top: -110px;
    width: 400px;
    height: 220px;
    border-radius: 50%;
    background: var(--c);
    filter: blur(44px);
    opacity: calc(var(--show) * var(--near) * 0.55);
    pointer-events: none;
  }

  /* The shadow each floating door casts on the mat */
  .shade {
    position: absolute;
    left: calc(var(--door-w) * -0.55);
    top: -16px;
    width: calc(var(--door-w) * 1.1);
    height: 40px;
    border-radius: 50%;
    background: rgba(24, 10, 36, 0.55);
    filter: blur(16px);
    opacity: calc(var(--show) * (0.35 + 0.4 * var(--front)));
    pointer-events: none;
  }

  .door {
    position: absolute;
    left: 0;
    bottom: 0;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transform: translateZ(calc(var(--e) * var(--hover))) translateX(-50%) rotateX(calc(var(--tilt) * -1));
    transform-origin: 50% 100%;
  }

  .is-in .door {
    pointer-events: auto;
  }

  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: var(--show);
    transform: translateY(calc((1 - var(--show)) * 70px));
  }

  /* Each door wears its own colour, with its name on it in the wordmark's type */
  .slab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: var(--door-w);
    height: var(--door-h);
    overflow: hidden;
    border-radius: 28px;
    background: var(--c);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
    color: #fff;
