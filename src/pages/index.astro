---
// The entrance. A flat dot grid with the sidelong plane on it; as you scroll, the grid tilts
// away into a floor and a door stands up for each place on the site. Scroll back up to return.
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import AppIcon from '../components/AppIcon.astro'
import { site } from '../site'

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order)
---

<Base immersive>
  <div class="journey" id="journey">
    <div class="scene" id="scene">
      <div class="sky" aria-hidden="true"></div>

      <div class="world">
        <div class="ground">
          <div class="dots" aria-hidden="true"></div>
          <div class="rug" aria-hidden="true"></div>
          <nav class="places" id="places" aria-label="Places">
            {
              site.places.map((place, i) => {
                const Door = place.href ? 'a' : 'span'
                return (
                  <div class="place" style={`--x: ${place.x}px; --d: ${place.d}px; --c: linear-gradient(135deg, ${place.colors}); --i: ${i}`}>
                    <span class="pool" aria-hidden="true" />
                    <Door class:list={['door', { big: place.big, closed: !place.href }]} href={place.href || undefined}>
                      <span class="stand">
                        <span class="slab">
                          {place.href === '/apps' && (
                            <span class="icons">
                              {apps.map((app) => <AppIcon app={app} size={38} />)}
                            </span>
                          )}
                        </span>
                        <span class="tag">
                          <b><i aria-hidden="true" />{place.label}</b>
                          <small>{place.href ? place.sub : 'Coming soon'}</small>
                        </span>
                      </span>
                    </Door>
                  </div>
                )
              })
            }
          </nav>
        </div>
      </div>

      <div class="intro">
        <p class="wordmark" aria-hidden="true">sidelong</p>
        <div class="hello">
          <h1>Hi, I'm {site.author}. I make things on the side.</h1>
          <button class="button" id="enter" type="button">
            Come in
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
          </button>
        </div>
      </div>

      <header class="top">
        <a class="brand" id="home" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M10 6h18l-4 20H6z" fill="#F0566E" stroke="#F0566E" stroke-width="3" stroke-linejoin="round"></path>
          </svg>
          {site.name}
        </a>
        <p class="where">Where would you like to go?</p>
      </header>

      <div class="flood" aria-hidden="true"></div>
    </div>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client'

  const calm = matchMedia('(prefers-reduced-motion: reduce)')
  const phone = matchMedia('(max-width: 820px)')
  const clamp = (n: number) => Math.min(1, Math.max(0, n))

  // The scroll position at which you are fully in the room.
  const room = (journey: HTMLElement) => journey.offsetTop + journey.offsetHeight - innerHeight

  // How far through the entrance the page is scrolled: 0 at the top, 1 in the room.
  let queued = false
  const update = () => {
    queued = false
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    if (!journey || !scene) return
    const span = room(journey) - journey.offsetTop || 1
    const p = calm.matches || phone.matches ? 1 : clamp((scrollY - journey.offsetTop) / span)
    scene.style.setProperty('--p', p.toFixed(4))
    scene.style.setProperty('--e', (p * p * (3 - 2 * p)).toFixed(4)) // eased, for the tilt
    scene.classList.toggle('is-mid', p > 0.3)
    scene.classList.toggle('is-in', p > 0.92)
    if (p > 0.92) sessionStorage.setItem('sidelong-entered', '1')
  }
  const request = () => {
    if (!queued) requestAnimationFrame(update)
    queued = true
  }
  addEventListener('scroll', request, { passive: true })
  addEventListener('resize', request)

  // When scrolling stops partway through the entrance, finish the move in the direction
  // the visitor was going: down into the room, or back up to the entrance.
  let lastY = scrollY
  let goingDown = true
  let settle = 0
  addEventListener(
    'scroll',
    () => {
      if (scrollY !== lastY) goingDown = scrollY > lastY
      lastY = scrollY
      clearTimeout(settle)
      settle = window.setTimeout(snap, 140) // after the last scroll event, momentum included
    },
    { passive: true },
  )
  const snap = () => {
    const journey = document.getElementById('journey')
    if (!journey || calm.matches || phone.matches) return
    const end = room(journey)
    if (scrollY <= journey.offsetTop + 1 || scrollY >= end - 1) return
    scrollTo({ top: goingDown ? end : journey.offsetTop, behavior: 'smooth' })
  }

  document.addEventListener('astro:page-load', () => {
    const journey = document.getElementById('journey')
    const scene = document.getElementById('scene')
    if (!journey || !scene) return

    // Coming back during the same visit lands in the room; scrolling up still shows the entrance.
    if (sessionStorage.getItem('sidelong-entered') && scrollY < 4 && !phone.matches) {
      scrollTo({ top: room(journey), behavior: 'instant' })
    }
    update()

    document.getElementById('enter')?.addEventListener('click', () => {
      const top = phone.matches ? document.getElementById('places')!.offsetTop - 24 : room(journey)
      scrollTo({ top, behavior: calm.matches ? 'instant' : 'smooth' })
    })

    document.getElementById('home')?.addEventListener('click', (e) => {
      e.preventDefault()
      scrollTo({ top: 0, behavior: calm.matches ? 'instant' : 'smooth' })
    })

    // Walking through a door: move toward it, let its colour fill the view, then go.
    scene.querySelectorAll<HTMLAnchorElement>('a.door').forEach((door) => {
      door.addEventListener('click', (e) => {
        if (calm.matches || phone.matches || e.metaKey || e.ctrlKey || e.shiftKey) return
        e.preventDefault()
        const place = getComputedStyle(door.parentElement!)
        scene.style.setProperty('--slide', `calc(${place.getPropertyValue('--x')} * -0.7)`)
        scene.style.setProperty('--flood', place.getPropertyValue('--c'))
        scene.classList.add('is-leaving')
        setTimeout(() => navigate(door.href), 520)
      })
    })
  })
</script>

<style>
  /* Extra height to scroll through; the scene stays pinned while the scroll plays it */
  .journey {
    height: 240svh;
  }

  .scene {
    --p: 0;
    --e: 0;
    --tilt: calc(var(--e) * 70deg);
    --horizon: 66%;
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ground);
    perspective: 1100px;
    perspective-origin: 50% 40%;
  }

  /* A little warm light at the horizon once you're inside */
  .sky {
    position: absolute;
    inset: 0;
    opacity: calc(var(--e) * 0.55);
    background: radial-gradient(
      ellipse 60% 42% at 50% 26%,
      rgba(255, 130, 102, 0.3),
      rgba(242, 89, 156, 0.14) 45%,
      transparent 72%
    );
  }

  /* The camera: settles lower and closer as you enter, follows the pointer a little,
     and moves forward when you pick a door */
  .world {
    position: absolute;
    inset: 0;
    pointer-events: none; /* only the doors take clicks, wherever they sit in depth */
    transform-style: preserve-3d;
    transform-origin: 50% var(--horizon);
    transform: translate3d(0, calc(var(--e) * 9vh), calc(var(--e) * 110px))
      rotateY(calc(var(--e) * (var(--mx, 0.5) - 0.5) * -5deg));
    transition: transform 0.25s ease-out;
  }

  .is-leaving .world {
    transform: translate3d(var(--slide, 0px), 9vh, 460px);
    transition: transform 0.7s var(--ease);
  }

  /* The ground: flat like a wall at first, then tilted away into a floor */
  .ground {
    position: absolute;
    left: 50%;
    top: var(--horizon);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt));
  }

  .dots {
    position: absolute;
    left: -2200px;
    top: -2700px;
    width: 4400px;
    height: 3400px;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 32%, transparent) 1.2px, transparent 1.9px);
    background-size: var(--dots) var(--dots);
    -webkit-mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
    mask-image: radial-gradient(ellipse 50% 62% at 50% 79.4%, #000 28%, transparent 74%);
  }

  /* The sidelong plane: the mark on the entrance, then a rug on the floor.
     It is the one fully coloured thing in the room. */
  .rug {
    position: absolute;
    left: -380px;
    top: -440px;
    width: 760px;
    height: 440px;
    border-radius: 44px;
    background: var(--wallpaper);
    box-shadow: -30px 40px 80px var(--shadow);
    transform: skewX(calc(var(--angle) * -1));
  }

  .places {
    transform-style: preserve-3d; /* keep the doors in the floor's 3D space */
  }

  /* Each place sits at a spot on the floor, with its door standing upright on it.
     --show runs 0 to 1 as its door rises, a little later for each door. */
  .place {
    --show: clamp(0, calc((var(--p) - 0.5 - var(--i) * 0.05) * 5), 1);
    position: absolute;
    left: var(--x);
    top: calc(var(--d) * -1);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  /* The door's colour, as light on the floor */
  .pool {
    position: absolute;
    left: -200px;
    top: -110px;
    width: 400px;
    height: 220px;
    border-radius: 50%;
    background: var(--c);
    filter: blur(44px);
    opacity: calc(var(--show) * 0.28);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .is-in .place:hover .pool,
  .is-in .place:focus-within .pool {
    opacity: 0.8;
  }

  .door {
    position: absolute;
    left: 0;
    bottom: 0;
    color: var(--ink);
    text-decoration: none;
    transform: translateX(-50%) rotateX(calc(var(--tilt) * -1));
    transform-origin: 50% 100%;
  }

  .is-in .door {
    pointer-events: auto;
  }

  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    opacity: var(--show);
    transform: translateY(calc((1 - var(--show)) * 70px));
  }

  /* Doors are plain; the colour shows as a line of light underneath, and fills the door on hover */
  .slab {
    position: relative;
    display: grid;
    place-items: center;
    width: 190px;
    height: 260px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: -18px 24px 50px var(--shadow);
    transform: skewX(calc(var(--angle) * -1));
    transition: transform 0.5s var(--ease);
  }

  .slab::before,
  .slab::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c);
  }

  .slab::before {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .slab::after {
    top: auto;
    height: 8px;
  }

  .big .slab {
    width: 250px;
    height: 330px;
  }

  a.door:hover .slab,
  a.door:focus-visible .slab {
    transform: skewX(calc(var(--angle) * -1)) translateY(-12px);
  }

  a.door:hover .slab::before,
  a.door:focus-visible .slab::before {
    opacity: 1;
  }

  .closed .slab {
    opacity: 0.7;
  }

  .icons {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 38px);
    gap: 12px;
    justify-content: center;
    transform: skewX(var(--angle));
  }

  .tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 8px 20px var(--shadow);
    white-space: nowrap;
  }

  .tag b {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--display);
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .tag i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  .tag small {
    font-size: 13px;
    color: var(--muted);
  }

  /* The entrance: wordmark on the plane, a greeting and one button. Fades as you scroll. */
  .intro {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--p) * 3.4);
    transform: translateY(calc(var(--p) * -90px));
  }

  .is-mid .intro {
    visibility: hidden;
  }

  .wordmark {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--horizon) - 440px);
    display: grid;
    place-items: center;
    height: 440px;
    margin: 0;
    color: #1f1a24;
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(72px, 11vw, 148px);
    letter-spacing: -0.04em;
  }

  .hello {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--horizon) + 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 0 24px;
    text-align: center;
    pointer-events: auto;
  }

  .hello h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .hello .button {
    gap: 8px;
    border: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .hello .button:hover {
    transform: translateY(3px);
  }

  /* Inside: the brand (which takes you back up) and a prompt */
  .top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    padding: 0 80px;
    opacity: clamp(0, calc((var(--p) - 0.7) * 4), 1);
    pointer-events: none;
  }

  .is-in .top {
    pointer-events: auto;
  }

  .where {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  .flood {
    position: absolute;
    inset: 0;
    background: var(--flood, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .is-leaving .flood {
    opacity: 1;
  }

  /* Phones: no 3D. The entrance, then the doors in a simple grid below it. */
  @media (max-width: 820px) {
    .journey {
      height: auto;
    }

    .scene {
      position: relative;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      height: auto;
      min-height: 0;
      padding-top: 120px;
      overflow: visible;
      perspective: none;
      background: transparent;
    }

    .world,
    .ground {
      display: contents;
    }

    .place,
    .door {
      position: static;
      width: auto;
      height: auto;
      transform: none;
    }

    .sky,
    .dots,
    .pool,
    .top {
      display: none;
    }

    .rug {
      position: static;
      order: 1;
      width: auto;
      height: 240px;
      margin: 0 32px;
      border-radius: 32px;
    }

    .scene .intro {
      position: static;
      order: 2;
      opacity: 1;
      transform: none;
      visibility: visible;
    }

    .wordmark {
      top: 120px;
      height: 240px;
    }

    .hello {
      position: static;
      min-height: calc(100svh - 360px);
      box-sizing: border-box;
      padding: 44px 24px 96px;
    }

    .places {
      order: 3;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
      padding: 24px 24px 64px;
    }

    .door {
      pointer-events: auto;
    }

    .slab,
    .big .slab {
      width: auto;
      height: 180px;
    }

    .stand {
      align-items: stretch;
    }

    .tag {
      white-space: normal;
      text-align: center;
    }
  }

  /* Reduced motion: no scroll-through; you start in the room */
  @media (prefers-reduced-motion: reduce) {
    .journey {
      height: auto;
    }

    .scene,
    .scene * {
      transition: none !important;
    }
  }
</style>
