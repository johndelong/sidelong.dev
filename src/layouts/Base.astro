---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import { site } from '../site'
import Header from '../components/Header.astro'

const { title, description = site.intro, theme, immersive = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:ital,wght@0,600;0,700;1,600;1,700&display=swap"
    />
    <ClientRouter />
  </head>
  <body style={theme}>
    {immersive ? <slot /> : (
    <Fragment>
    <div class="dotlight" aria-hidden="true"></div>
    <div class="page">
      <Header />
      <main><slot /></main>
      <footer class="footer">
        <div class="wrap footer-inner">
          <span>© {new Date().getFullYear()} {site.author}</span>
          <nav class="footer-links" aria-label="Social profiles">
            {site.contact.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </div>
      </footer>
    </div>
    </Fragment>
    )}
    <script>
      // Feed the pointer to CSS: --mx leans the plane, --px/--py light the dots.
      const root = document.documentElement
      let queued = false
      addEventListener('pointermove', (e) => {
        if (queued) return
        queued = true
        requestAnimationFrame(() => {
          queued = false
          root.style.setProperty('--mx', (e.clientX / innerWidth).toFixed(3))
          root.style.setProperty('--px', `${e.pageX}px`)
          root.style.setProperty('--py', `${e.pageY}px`)
        })
      })
    </script>
    <script>
      import '../scripts/zoom'
      import '../scripts/veil'
    </script>
  </body>
</html>
