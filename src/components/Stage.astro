---
// The leaning gradient plane with an upright frame in front of it. A phone app's hero is one
// tall phone, so its stage is taller and the phone stands nearly the full height of the plane.
const { tall = false, phone = false, href } = Astro.props
const Frame = href ? 'a' : 'div'
---

<div class:list={['stage', { tall, phone }]}>
  <div class="stage-plane par-slow" aria-hidden="true">
    <div class="lean"><div class="plane"></div></div>
  </div>
  <div class="stage-front par-fast">
    <div class="shotin">
      <Frame class="shot frame" href={href}><slot /></Frame>
    </div>
  </div>
</div>
